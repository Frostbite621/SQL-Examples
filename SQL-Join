SELECT c1.courseid, c1.courseshortname, prereq.prerequisiteid, c2.courseshortname
FROM course c1
join prerequisite prereq on prereq.courseid = c1.courseid
join course c2 on c2.courseid = prereq.prerequisiteid
ORDER BY c1.courseid ASC;

--
--
--

SELECT c1.courseid, c1.courseshortname, COUNT(prereq.prerequisiteid) "Number of Prerequisites"
FROM course c1
join prerequisite prereq on prereq.courseid = c1.courseid
join course c2 on c2.courseid = prereq.prerequisiteid
GROUP BY c1.courseid, c1.courseshortname
HAVING COUNT(prereq.prerequisiteid) >= 3;

